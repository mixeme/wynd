{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"types": ["svelte", "vite/client"],
		"paths": {
			"$ui/*": ["../../../web/src/lib/components/*"],
			"$lib/*": ["../../../web/src/lib/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.svelte"]
}
