# Wynd production reverse proxy for docker compose.
# Replace example.org with your public hostname.
# Bare-metal Caddy (systemd) uses deploy/proxy/Caddyfile → 127.0.0.1:7676.

{
	email admin@example.org
}

example.org {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy wynd:7676 {
		flush_interval -1
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		transport http {
			read_timeout 300s
		}
	}

	request_body {
		max_size 100MB
	}
}
