# Wynd reverse proxy snippet for Caddy.
# Replace example.org with your public hostname.

example.org {
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    reverse_proxy 127.0.0.1:7676 {
        flush_interval -1
        transport http {
            read_timeout 300s
        }
    }
    request_body {
        max_size 100MB
    }
}
