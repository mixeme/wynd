[Unit]
Description=Wynd private circle journal
Documentation=https://github.com/mixeme/wynd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wynd
Group=wynd
Environment=WYND_DATA_DIR=/var/lib/wynd
ExecStart=/usr/local/bin/wynd
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wynd

[Install]
WantedBy=multi-user.target
